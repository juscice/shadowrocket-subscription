# WPS：上游响应改写，未作设备实测
member_WPS = type=http-response, pattern=^https?:\/\/(?:[A-Za-z0-9-]+\.)?account\.wps\.(?:com|cn)(?::\d+)?\/api\/users\/\w+\/overview(?:\?|$), requires-body=true, script-path=https://raw.githubusercontent.com/I-am-R-E/Functional-Store-Hub/Master/WPSOffice/Script/WPS.js, timeout=15
# xmind思维导图：上游响应改写，未作设备实测
member_xmind = type=http-response, pattern=https?:\/\/www\.xmind\.(cn|net|app)\/\_res\/devices, requires-body=true, script-path=https://raw.githubusercontent.com/I-am-R-E/Functional-Store-Hub/Master/Xmind/Script/Xmind.js, timeout=15
# 有道云笔记：上游响应改写，未作设备实测
member_ydybj = type=http-response, pattern=^https:\/\/note\.youdao\.com\/yws\/(?:mapi\/payment|api\/self)(?:\?|$), requires-body=true, script-path=https://raw.githubusercontent.com/Alex0510/Eric/master/surge/Script/ydybj.js, timeout=15
# 微信读书免费卡解锁：仅旧版 6.0.1/5.4.3，源码混淆，按用户要求启用
member_wxds = type=http-response, pattern=^https:\/\/i\.weread\.qq\.com\/pay\/memberCardSummary, requires-body=true, script-path=https://raw.githubusercontent.com/89996462/Quantumult-X/main/ycdz/txwxds.js, timeout=15, enable=true
# RevenueCat 多 App：仅保留一个按 User-Agent 分派的合集；匹配表不是实测可用名单。
member_revenuecat_request = type=http-request, pattern=^https?:\/\/api\.(?:revenuecat|rc-backup)\.com\/v1\/(?:subscribers\/[^\/]+$|receipts$), requires-body=false, script-path=https://raw.githubusercontent.com/Guding88/Script/main/APPheji_Revenuecat.js, timeout=15
member_revenuecat_response = type=http-response, pattern=^https?:\/\/api\.(?:revenuecat|rc-backup)\.com\/v1\/(?:subscribers\/[^\/]+$|receipts$), requires-body=true, script-path=https://raw.githubusercontent.com/Guding88/Script/main/APPheji_Revenuecat.js, timeout=15
member_spotify_request = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-json.js
member_spotify_response = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-proto.js,script-update-interval=0

