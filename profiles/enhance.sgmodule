[Body Rewrite]
http-response-jq ^https?:\/\/app\.mieco\.net\/api\/utrend-printing\/buttonConfig\/1(?:\?.*)?$ '.data |= map(select((.name != "首页" or true != true) and (.name != "社区" or true != true) and (.name != "创意" or true != true) and (.name != "消息" or true != true) and (.name != "我的" or false != true)))'
http-response-jq ^https?:\/\/app\.mieco\.net\/api\/utrend-printing\/users(?:\?.*)?$ 'if true then .data.background = "" | .data.userLevelIcon = "" | .data.userLevel = 0 | .data.experience = 0 else . end'

[Header Rewrite]
http-request ^https://www\.zhihu\.com\/(question|topic) header-replace User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/78.0.3904.108 Safari/537.36"

# RevenueCat/Spotify会员接口缓存控制已随上游脚本处理
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[Script]
feature_0001 = type=http-request, script-path=https://lowertop.github.io/Shadowrocket-First/JS/github-header.js, pattern=^https:\/\/[a-z0-9-]+\.githubusercontent\.com, max-size=0, timeout=30, script-update-interval=0, enable=true
