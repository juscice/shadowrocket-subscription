feature_0012 = type=http-response,pattern=(?:^https?:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?)|(?:^https?:\/\/api\.weibo\.cn\/2\/cardlist\?),requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/Plugins/VVebo_Repair.js
